DATABASE_URL=postgres://assetflow:assetflow@localhost:5432/assetflow?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-at-least-32-random-bytes
JWT_TTL=1h
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# How GET /assets loads allocations: batched (default), join, nplus1 (perf baseline only)
LIST_STRATEGY=batched
# Stripe test mode (optional; payment routes are disabled without a key).
# Webhook secret: `stripe listen --forward-to localhost:8080/webhooks/stripe` prints it.
# The webhook endpoint's API version must match stripe-go v81's stripe.APIVersion.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD=pm_card_visa
# LLM agent (optional; without a key POST /agent/chat uses the built-in fake model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AGENT_TOOL_TIMEOUT=5s
# cmd/worker (uses DATABASE_URL, LOG_LEVEL and SHUTDOWN_TIMEOUT too)
WORKER_CONCURRENCY=8
# WORKER_ID defaults to <hostname>-<pid>
